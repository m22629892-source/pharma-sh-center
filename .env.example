# Copy to .env on the Windows computer running the backend. Never commit .env.
DATA_BACKEND=sqlserver
VITE_DATA_BACKEND=sqlserver
HOST=127.0.0.1
PORT=3000
DB_SERVER=DESKTOP-PNT7PJT
DB_INSTANCE=TMSQLEXPRESS
# Use DB_PORT instead of DB_INSTANCE if SQL Browser discovery is unavailable.
# DB_PORT=1433
DB_DATABASE=PharmaSHCenter
DB_USER=YOUR_SQL_LOGIN
DB_PASSWORD="REPLACE_LOCALLY"
DB_TDS_VERSION=7_3_A
# Explicit opt-in: login reads dbo.Users.password as stored text.
DB_PASSWORD_MODE=plaintext
# Local SQL Server 2008 connection; enable encryption when server TLS is configured.
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=false
SESSION_COOKIE_SECURE=false
GEMINI_API_KEY=
APP_URL=http://localhost:3000
